{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,        // ✅ Don’t check .d.ts files in node_modules
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@scripts/*": ["scripts/*"],
      "@logs/*": ["logs/*"]
    }
  },
  "typeRoots": [
  "./node_modules/@types",
  "./types"
],

  "include": [
  "scripts/**/*.ts",
  "src/**/*.ts",
  "src/**/*.tsx"
  ],

  "exclude": ["node_modules", "logs", "**/*.txt","tmp"]
}
